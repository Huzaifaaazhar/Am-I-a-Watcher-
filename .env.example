# Copy to .env.local. Nothing here is a secret by default - inference is local.

# ---------------------------------------------------------------- engine
# procedural : in-process classifier + grammar. No model, no network, sub-ms,
#              deterministic. This is the default and the fallback.
# ollama     : a local LLM over loopback. Better prose, needs a daemon running.
CAUSALITY_PROVIDER=procedural

# Only read when CAUSALITY_PROVIDER=ollama.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=20000

# ---------------------------------------------------------- observability
# trace | debug | info | warn | error
LOG_LEVEL=info
# Custodian premises are user free text and are redacted from logs by default.
# Set to 1 only while debugging a bad cascade locally.
LOG_PREMISES=0
# When set, /api/metrics requires `Authorization: Bearer <token>`.
# Leave unset if the endpoint is bound to an internal interface instead.
METRICS_TOKEN=

# --------------------------------------------------------------- limits
RATE_LIMIT_MAX=12
RATE_LIMIT_WINDOW_MS=60000
DAILY_CALL_CAP=300

# Set to 1 ONLY behind a reverse proxy that overwrites x-forwarded-for.
# Unset, all callers share one rate-limit bucket (stricter, unspoofable).
TRUST_PROXY=0
