# Copy to .env.local and fill in. .env.local is gitignored - never commit a real key.

# Required. Server-side only: this is read in the API route and is never
# exposed to the browser (it has no NEXT_PUBLIC_ prefix, so Next.js will not
# inline it into the client bundle).
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-haiku-4-5 (fast, cheap - good for the reel).
# Bump to claude-opus-5 if you want sharper writing and can accept the latency.
CAUSALITY_MODEL=claude-haiku-4-5

# Optional budget guardrails for /api/causality.
# Per-IP sliding window:
RATE_LIMIT_MAX=12
RATE_LIMIT_WINDOW_MS=60000
# Hard process-wide daily cap on LLM calls. Once hit, the route refuses
# until UTC midnight. This is what stops a shared URL burning your budget.
DAILY_CALL_CAP=300

# Set to 1 ONLY when a reverse proxy that overwrites x-forwarded-for sits in
# front of this process. Left unset, all callers share one rate-limit bucket
# (stricter, and not bypassable by spoofing the header).
TRUST_PROXY=0
